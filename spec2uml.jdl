enum Language {
  EN, ES, FR, DE
}

enum RequirementStatus {
  DRAFT, IN_REVIEW, APPROVED, REJECTED
}

entity Project {
  name String required
  description TextBlob
  language Language required
  umlVersion String
  createdAt Instant required
  updatedAt Instant
}

entity ProjectStatistics {
  requirements Integer min(0)
  completed Integer min(0)
  approved Integer min(0)
}

entity Requirement {
  // Basic Requirement Fields
  sentId Integer required
  text TextBlob required
  source String required
  projectId String required
  type String required
  specLevel String required
  
  classDiagram TextBlob
  useCaseDiagram TextBlob
  
  // Status and Timestamps
  status RequirementStatus required
  createdAt Instant required
  updatedAt Instant
}

entity RequirementUseCaseConcepts {
    // Parent holder for use case extraction
}

entity UseCaseActor {
    name String required
    description TextBlob
}

entity UseCaseConcept {
    name String required
    description TextBlob
    trigger String
    systemBoundary String
}

entity UseCaseActorRef {
    actorName String required
}

entity UseCaseCondition {
    conditionText String
}

entity UseCaseBusinessRule {
    ruleText String
}

entity UseCaseRelationship {
    source String required
    target String required
    type String required
    label String
}

entity RequirementClassConcepts {
}

entity ClassConcept {
    name String required
    stereotype String
}

entity ClassAttribute {
    name String required
    type String required
    visibility String // public, private, protected
}

entity ClassOperation {
    name String
    returnType String
}

entity OperationParameter {
    paramName String
}

entity ClassRelationship {
    source String required
    target String required
    type String required // Association, Aggregation, Composition, Inheritance
    sourceMultiplicity String
    targetMultiplicity String
    label String
}

// ==========================================
// RELATIONSHIPS
// ==========================================

// --- One-to-One Relationships (Embedded Objects) ---
relationship OneToOne {
  Project{statistics} to ProjectStatistics
  Requirement{useCaseConcepts} to RequirementUseCaseConcepts
  Requirement{classConcepts} to RequirementClassConcepts
}

// --- One-to-Many Relationships (Arrays of Objects & Collections) ---
relationship OneToMany {
  // OPTIMIZATION: Removed Project{requirements} from here.
  // Project no longer maintains an array of Requirement references.

  // Use Case Concepts Structure
  RequirementUseCaseConcepts{actors} to UseCaseActor
  RequirementUseCaseConcepts{useCases} to UseCaseConcept
  RequirementUseCaseConcepts{relationships} to UseCaseRelationship
  UseCaseConcept{primaryActors} to UseCaseActorRef
  UseCaseConcept{secondaryActors} to UseCaseActorRef
  UseCaseConcept{preconditions} to UseCaseCondition
  UseCaseConcept{postconditions} to UseCaseCondition
  UseCaseConcept{businessRules} to UseCaseBusinessRule

  // Class Concepts Structure
  RequirementClassConcepts{classes} to ClassConcept
  RequirementClassConcepts{relationships} to ClassRelationship
  ClassConcept{attributes} to ClassAttribute
  ClassConcept{operations} to ClassOperation
  ClassOperation{parameters} to OperationParameter
}

// --- Many-to-One Relationships ---
relationship ManyToOne {
  Project{createdBy} to User
  
  // OPTIMIZATION: 
  // 1. Requirement references Project (ManyToOne) to support 50,000+ items.
  // 2. Uses '(name)' to map 'projectName' in DTO, preventing conflict with legacy 'projectId'.
  Requirement{project(name) required} to Project
}

// --- Many-to-Many Relationships ---
relationship ManyToMany {
  Requirement{annotators} to User{annotatedRequirement}
  Project{annotators} to User{annotatedProjects}
  Project{reviewers} to User{reviewedProjects}
}

// ==========================================
// CONFIGURATION OPTIONS
// ==========================================

dto * with mapstruct
service * with serviceClass
paginate Project, Requirement with pagination